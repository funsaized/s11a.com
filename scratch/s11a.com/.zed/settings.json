{
	"languages": {
		"CSS": {
			"language_servers": ["tailwindcss-intellisense-css"]
		},
		"TypeScript": {
			"language_servers": ["vtsls", "oxfmt", "oxlint", "!eslint", "..."]
		},
		"TSX": {
			"language_servers": ["vtsls", "oxfmt", "oxlint", "!eslint", "..."]
		}
	},
	"lsp": {
		"tailwindcss-language-server": {
			"binary": {
				"path": "./node_modules/.bin/tailwindcss-language-server",
				"arguments": ["--stdio"]
			},
			"settings": {
				"tailwindCSS": {
					"classFunctions": ["cva", "cn"]
				}
			}
		},
		"vtsls": {
			"settings": {
				"typescript": {
					"tsdk": "node_modules/typescript/lib"
				}
			}
		}
	}
}
